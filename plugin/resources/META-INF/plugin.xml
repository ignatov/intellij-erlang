<idea-plugin url="https://ignatov.github.io/intellij-erlang" xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>org.jetbrains.erlang</id>
    <vendor email="ignatovs@gmail.com">Sergey Ignatov</vendor>
    <depends>com.intellij.modules.lang</depends>
    <!-- The test runner and the structure view are separate plugins of the IDE. These are their ids in 2026.2;
         later IDEs keep them as aliases. -->
    <depends>intellij.testRunner.plugin</depends>
    <depends>intellij.structureView.plugin</depends>
    <name>Erlang</name>
    <description><![CDATA[
    <p>Erlang support for IntelliJ IDEA, PyCharm, WebStorm, PhpStorm, RubyMine and other JetBrains IDE.</p>
    <p>
    Feel free to file new feature requests as an issue on <a href="https://github.com/ignatov/intellij-erlang/issues">GitHub</a>.
    </p>
    <p>
        If you find this plugin useful, consider making a <a href="https://github.com/sponsors/ignatov">donation</a> to support the project.
    </p>
    ]]>
    </description>
    <change-notes>
        <![CDATA[
            <ul>
              <li>Show the "Project SDK is not defined" banner again in IntelliJ IDEA for .erl and .hrl files when no SDK is set (<a href="https://github.com/ignatov/intellij-erlang/issues/1269">#1269</a>)</li>
              <li>Behaviour names of files that are not open are read from the index, without parsing the file (<a href="https://github.com/ignatov/intellij-erlang/issues/1382">#1382</a>)</li>
              <li>Find include quick fix now finds .hrl headers (<a href="https://github.com/ignatov/intellij-erlang/pull/1384">#1384</a>)</li>
              <li>Variables bound by code sent with Send Selection to Erlang Console are now known to the console (<a href="https://github.com/ignatov/intellij-erlang/pull/1377">#1377</a>)</li>
              <li>Jump to Source now works for EUnit tests made by generators and fixtures; Rerun Failed Tests reruns their generator, or says which failed… (<a href="https://github.com/ignatov/intellij-erlang/pull/1375">#1375</a>)</li>
            </ul>
        ]]>
    </change-notes>

    <depends optional="true" config-file="java-deps.xml">com.intellij.modules.java</depends>
    <depends optional="true" config-file="copyright.xml">com.intellij.copyright</depends>

    <xi:include href="ErlangPlugin.xml" xpointer="xpointer(/idea-plugin/*)">
        <xi:fallback>
            <xi:include href="/META-INF/ErlangPlugin.xml" xpointer="xpointer(/idea-plugin/*)"/>
        </xi:fallback>
    </xi:include>
</idea-plugin>
